# Discord application credentials (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_APP_ID=your-application-id
# Optional: register slash commands instantly in one server instead of globally
DISCORD_GUILD_ID=

# Your SAGE deployment
SAGE_API_URL=https://sage-campus-spark.lovable.app
# Must match the SAGE_BOT_TOKEN secret configured in the SAGE app
SAGE_BOT_TOKEN=your-shared-bot-token
